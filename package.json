{
  "name": "@moggie/runtime",
  "version": "0.1.0",
  "main": "index.js",
  "types": "index.d.ts",
  "author": {
    "name": "Louis Capitanchik",
    "email": "louis@weirdboi.com"
  },
  "repository": "https://github.com/moggie-framework/runtime.git",
  "description": "Node module loading tools for applying custom transforms to imported modules at runtime",
  "napi": {
    "name": "runtime",
    "triples": {
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-unknown-freebsd"
      ]
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "ava": "^6.0.1",
    "prettier": "^3.5.3"
  },
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "universal": "napi universal",
    "version": "napi version",
    "format": "prettier --write '**/*.{js,mjs,ts,tsx}'"
  },
  "exports": {
    ".": "./index.js",
    "./helpers/polyfill": "./polyfill.mjs"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
